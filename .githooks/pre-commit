
#!/bin/sh

echo "Running pre-commit hook..."

if git diff --cached --unified=0 -- . ':(exclude).githooks/pre-commit' | grep -nE '^\+[^+].*(TODO|FIXME)'
then
    echo "ERROR: TODO or FIXME found in staged changes!"
    echo "Remove TODO or FIXME before committing."
    exit 1
fi

echo "Pre-commit check passed!"
exit 0
